# Copy to .env for local development. Never commit .env.

DATABASE_URL=postgres://postgres@localhost:5432/rishari
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# "dev" gives a local sign-in screen with no password. It refuses to start in production.
# Use "clerk" with real keys to test real sign-in.
AUTH_MODE=dev
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Required in production. Any long random string.
DOWNLOAD_SIGNING_SECRET=

# "local" stores uploads on disk (development only). "s3" for Cloudflare R2, AWS S3, or similar.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.data/uploads
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
UPLOAD_MAX_BYTES=10485760

# Runtime AI arrives in Pass 2. Leave off until the data-use page is reviewed.
AI_ENABLED=false
OPENAI_API_KEY=
INTAKE_MODEL=gpt-6-sol
STRATEGY_MODEL=gpt-6-sol
