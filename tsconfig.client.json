{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "noEmit": true,
    "paths": {
      "@shared/*": [
        "./shared/*"
      ]
    },
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "client/src",
    "shared",
    "server/seed/questions.ts",
    "server/seed/guidance.ts"
  ]
}